{
  "name": "wildland",
  "version": "3.0.0",
  "private": true,
  "description": "Offline Thai wilderness survival game for the web and Android",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/econDS/wildland.git"
  },
  "scripts": {
    "start": "python -m http.server 8943 --bind 127.0.0.1",
    "test": "node --test tests/engine.test.js tests/world.test.js tests/expedition.test.js tests/planning.test.js",
    "test:simulation": "node tests/simulate.js",
    "build:web": "node scripts/build-web.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "cap:sync": "npm run build:web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "sharp": "0.35.5"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
